# Separate website: https://homecraft-mc.pp.ua; Minecraft stays on its own host.
HOST=0.0.0.0
PORT=3000
PUBLIC_SITE_URL=https://homecraft-mc.pp.ua
HOMECRAFT_PUBLIC_SITE_URL=https://homecraft-mc.pp.ua
HOMECRAFT_SERVER_SECRET=generated-by-setup-homecraft-config
HOMECRAFT_SITE_HOST=0.0.0.0
HOMECRAFT_SITE_PORT=3000
HOMECRAFT_MC_PORT=25618
HOMECRAFT_MC_HOST=51.83.184.222:25618
HOMECRAFT_AUTO_WHITELIST=true
HOMECRAFT_SERVER_NAME=Home Craft
HOMECRAFT_SERVER_HEARTBEAT_TTL_MS=90000
HOMECRAFT_MC_PING_ENABLED=false
HOMECRAFT_MC_PING_TIMEOUT_MS=2500
HOMECRAFT_MC_PING_CACHE_MS=3000
HOMECRAFT_MC_PROTOCOL=-1
HOMECRAFT_MC_TCP_FALLBACK_ENABLED=true

# Database files are split: user accounts and runtime state.
# Usually leave these defaults unchanged.
HOMECRAFT_USERS_DB_FILE=data/users.json
HOMECRAFT_RUNTIME_DB_FILE=data/runtime.json
# Permanent ownership/tombstone history; keep it when deleting accounts.
HOMECRAFT_CHARACTERS_DB_FILE=data/characters.json
HOMECRAFT_ASSETS_DB_FILE=data/assets.json
HOMECRAFT_UPLOADS_DIR=data/uploads
HOMECRAFT_MAX_UPLOAD_BYTES=1048576
HOMECRAFT_LOG_DIR=logs
HOMECRAFT_LOG_LEVEL=warn

# Admin bootstrap runs once per installation. Removing accounts does not reset it.
# At first R5.12 migration, these aliases are pinned to existing immutable account IDs.
# Re-registering the same email/login never transfers their administrator role.
HOMECRAFT_ADMIN_EMAIL=
HOMECRAFT_ADMIN_LOGIN=
# Server resource pack hosting
HOMECRAFT_RESOURCE_PACK_DIR=data/server-resource-packs
HOMECRAFT_RESOURCE_PACK_FILE=homecraft-resource-pack.zip
HOMECRAFT_RESOURCE_PACK_REQUIRE=false
HOMECRAFT_RESOURCE_PACK_PROMPT=Home Craft рекомендує встановити серверний ресурс-пак.
HOMECRAFT_MAX_RESOURCE_PACK_BYTES=33554432
HOMECRAFT_SERVER_MODS_DIR=client-mods
HOMECRAFT_CLIENT_MODS_MODE=auto
HOMECRAFT_CLIENT_MODS_INCLUDE=homecraftauth,homecraft-auth,homecraftguild,homecraft-guild,homecraftspawnprotection,homecraft-spawn-protection,spawnprotection,spawn-protection
HOMECRAFT_CLIENT_MODS_EXCLUDE=homecraftmap,homecraft-map,server-only,dedicated-server
HOMECRAFT_CLIENT_MODS_PROJECT_PREFIXES=homecraft,home-craft
HOMECRAFT_CLIENT_MODS_CACHE_MS=30000

# Realtime map bridge
HOMECRAFT_MAP_STATE_FILE=data/map-state.json
# Public NPC positions and trade snapshots, separate from user accounts.
HOMECRAFT_WORLD_CATALOG_FILE=data/world-catalog.json
HOMECRAFT_MAP_HEARTBEAT_TTL_MS=60000
HOMECRAFT_MAP_PUBLIC_MAX_TILES=256
HOMECRAFT_MAP_PUBLIC_DELTA_MAX_TILES=64
HOMECRAFT_MAP_SPAWN_RADIUS=96

# Spawn source shared by Auth and Realtime Map
HOMECRAFT_SPAWN_SOURCE=config
HOMECRAFT_SPAWN_X=3656
HOMECRAFT_SPAWN_Y=63
HOMECRAFT_SPAWN_Z=3852
HOMECRAFT_SPAWN_DIMENSION=minecraft:overworld
HOMECRAFT_MAP_SPAWN_X=3656
HOMECRAFT_MAP_SPAWN_Y=63
HOMECRAFT_MAP_SPAWN_Z=3852
HOMECRAFT_MAP_SPAWN_DIMENSION=minecraft:overworld
HOMECRAFT_SPAWN_SAFE_RADIUS=96

# Private, server-synced guild talent summaries (outside SITE/public).
HOMECRAFT_GUILD_TALENTS_FILE=data/guild-talents.json


# HTTPS domain behind Cloudflare Tunnel
COOKIE_SECURE=true

# Set true ONLY behind a trusted gateway that overwrites X-Forwarded-For.
HOMECRAFT_TRUST_PROXY=false
